rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.email == "diegofujisawajp@gmail.com" || 
              request.auth.token.firebase.sign_in_provider == "anonymous" ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.category.upper().matches('.*ADM.*')));
    }

    // Permissão total para o administrador em qualquer caminho
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    function isValidBicycle(data) {
      return data.patrimonio is string && data.patrimonio.size() > 0;
    }

    function isValidUser(data) {
      return data.login is string && data.login.size() > 0;
    }

    function isValidRequest(data) {
      return data.bikeNumber is string && data.bikeNumber.size() > 0;
    }

    function isValidReport(data) {
      return data.driverName is string && data.driverName.size() > 0 &&
             data.date is timestamp &&
             data.type is string && data.type.size() > 0;
    }

    function isValidAlert(data) {
      return data.bikeNumber is string && data.bikeNumber.size() > 0 &&
             data.type is string && data.type.size() > 0 &&
             data.status in ['Pendente', 'Encontrada'] &&
             data.timestamp is timestamp;
    }

    function isValidBoletim(data) {
      return data.bikeNumber is string && data.bikeNumber.size() > 0 &&
             data.date is string && data.date.size() > 0 &&
             data.boNumber is string && data.boNumber.size() > 0 &&
             data.author is string && data.author.size() > 0 &&
             data.timestamp is timestamp;
    }

    match /bikes/{patrimonio} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /requests/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /reports/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /alerts/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /locations/{id} {
      allow read, write: if isAuthenticated();
    }

    match /timeline_events/{id} {
      allow read, write: if isAuthenticated();
    }

    match /notifications/{id} {
      allow read, write: if isAuthenticated();
    }

    match /boletins/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidBoletim(request.resource.data);
    }

    match /pending_actions/{id} {
      allow get, list, create, update, delete: if isAuthenticated();
    }
    match /trailers_history/{id} {
      allow get, list, create, update, delete: if isAuthenticated();
    }
    match /sync/{id} {
      allow read, write: if isAuthenticated();
    }
  }
}
