{
  "entities": {
    "Bicycle": {
      "title": "Bicycle",
      "description": "Represents a bicycle in the system.",
      "type": "object",
      "properties": {
        "patrimonio": { "type": "string", "description": "Unique ID of the bike." },
        "modelo": { "type": "string", "description": "Model of the bike." },
        "status": { "type": "string", "description": "Current status (e.g., Em Estação, Em Rota, Recolhida)." },
        "localizacao": { "type": "string", "description": "Last known location name or station." },
        "latitude": { "type": "number", "description": "Last known latitude." },
        "longitude": { "type": "number", "description": "Last known longitude." },
        "ultimaAtualizacao": { "type": "string", "format": "date-time", "description": "Timestamp of the last update." },
        "observacao": { "type": "string", "description": "Additional notes." },
        "situacao": { "type": "string", "description": "Current situation (e.g., Ativa, Vandalizada)." },
        "dataSituacao": { "type": "string", "format": "date-time", "description": "When the situation was last changed." },
        "responsavel": { "type": "string", "description": "Current driver or person responsible." },
        "carretinha": { "type": "string", "description": "Name of the trailer the bike is in." }
      },
      "required": ["patrimonio", "status"]
    },
    "User": {
      "title": "User",
      "description": "Represents a driver or administrator.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID." },
        "login": { "type": "string", "description": "Username for legacy login." },
        "email": { "type": "string", "format": "email", "description": "User email." },
        "category": { "type": "string", "description": "User role (e.g., ADM, MOTORISTA, MECANICA)." },
        "plate": { "type": "string", "description": "Current vehicle plate." },
        "lastKmFinal": { "type": "number", "description": "Last reported final KM." },
        "gps": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        },
        "routeBikes": { "type": "array", "items": { "type": "string" }, "description": "List of bike IDs in the driver's route." },
        "collectedBikes": { "type": "array", "items": { "type": "string" }, "description": "List of bike IDs collected by the driver." }
      },
      "required": ["uid", "email", "category"]
    },
    "PickupRequest": {
      "title": "Pickup Request",
      "description": "A request to pick up a bike.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bikeNumber": { "type": "string" },
        "location": { "type": "string" },
        "reason": { "type": "string" },
        "recipient": { "type": "string" },
        "status": { "type": "string", "enum": ["Pendente", "Aceita", "Recusada", "Finalizada"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "driverName": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      },
      "required": ["bikeNumber", "status", "timestamp"]
    },
    "Report": {
      "title": "Report",
      "description": "Daily or operation report.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "driverName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string" },
        "bikeNumber": { "type": "string" },
        "observation": { "type": "string" },
        "kmFinal": { "type": "number" },
        "plate": { "type": "string" }
      },
      "required": ["driverName", "date", "type"]
    },
    "Alert": {
      "title": "Alert",
      "description": "System alerts for missing or vandalized bikes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bikeNumber": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "driverName": { "type": "string" },
        "status": { "type": "string", "enum": ["Pendente", "Encontrada"] }
      },
      "required": ["bikeNumber", "type", "status"]
    },
    "Location": {
      "title": "Location",
      "description": "Real-time driver location.",
      "type": "object",
      "properties": {
        "driverName": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["driverName", "latitude", "longitude", "timestamp"]
    },
    "TimelineEvent": {
      "title": "Timeline Event",
      "description": "Events for driver timeline.",
      "type": "object",
      "properties": {
        "driverName": { "type": "string" },
        "type": { "type": "string" },
        "bikeNumber": { "type": "string" },
        "date": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["driverName", "type", "date", "timestamp"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System notifications and commands.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "recipient": { "type": "string" },
        "bikes": { "type": "array", "items": { "type": "string" } },
        "trailerName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "timestamp"]
    },
    "BoletimRecord": {
      "title": "Boletim Record",
      "description": "Information about a police report (B.O.) for a bike.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bikeNumber": { "type": "string", "description": "Bike patrimônio number." },
        "date": { "type": "string", "format": "date", "description": "Date the report was made (YYYY-MM-DD)." },
        "boNumber": { "type": "string", "description": "Police report (B.O.) number." },
        "author": { "type": "string", "description": "Person who performed the report." },
        "summary": { "type": "string", "description": "Brief summary of the report." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When this record was created." }
      },
      "required": ["bikeNumber", "date", "boNumber", "author", "timestamp"]
    },
    "PendingAction": {
      "title": "Pending Action",
      "description": "Actions from mechanics that require admin approval.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["status_change", "trailer_validation"] },
        "bikeNumber": { "type": "string" },
        "bikes": { "type": "array", "items": { "type": "string" } },
        "targetStatus": { "type": "string" },
        "treatment": { "type": "string" },
        "mechanicName": { "type": "string" },
        "trailerName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["type", "status", "timestamp"]
    },
    "TrailerHistory": {
      "title": "Trailer History",
      "description": "History of released trailers for the day.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trailerName": { "type": "string" },
        "finalizedBy": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "bikeCount": { "type": "number" }
      },
      "required": ["trailerName", "timestamp", "date"]
    },
    "AlmoxarifadoItem": {
      "title": "Almoxarifado Item",
      "description": "Represents an inventory item in the warehouse.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "codigo": { "type": "string", "description": "Unique code of the item." },
        "descricao": { "type": "string", "description": "Description of the item." },
        "fornecedor": { "type": "string", "description": "Supplier of the item." },
        "quantidade": { "type": "number", "description": "Current available quantity." },
        "qtdMinima": { "type": "number", "description": "Minimum required stock level." },
        "historico": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "tipo": { "type": "string", "enum": ["entrada", "retirada"] },
              "quantidade": { "type": "number" },
              "usuario": { "type": "string" },
              "data": { "type": "string" }
            }
          }
        }
      },
      "required": ["codigo", "descricao", "fornecedor", "quantidade"]
    }
  },
  "firestore": {
    "/bikes/{patrimonio}": {
      "schema": "Bicycle",
      "description": "Collection of all bicycles."
    },
    "/users/{driverId}": {
      "schema": "User",
      "description": "Collection of all users and their states. The driverId is the normalized login name."
    },
    "/requests/{id}": {
      "schema": "PickupRequest",
      "description": "Collection of pickup requests."
    },
    "/reports/{id}": {
      "schema": "Report",
      "description": "Collection of operational reports."
    },
    "/alerts/{id}": {
      "schema": "Alert",
      "description": "Collection of system alerts."
    },
    "/locations/{id}": {
      "schema": "Location",
      "description": "Collection of real-time locations."
    },
    "/timeline_events/{id}": {
      "schema": "TimelineEvent",
      "description": "Collection of timeline events."
    },
    "/notifications/{id}": {
      "schema": "Notification",
      "description": "Collection of system notifications."
    },
    "/boletins/{id}": {
      "schema": "BoletimRecord",
      "description": "Collection of police reports for bikes."
    },
    "/pending_actions/{id}": {
      "schema": "PendingAction",
      "description": "Collection of actions pending admin approval."
    },
    "/trailers_history/{id}": {
      "schema": "TrailerHistory",
      "description": "Collection of released trailers history."
    },
    "/almoxarifado/{id}": {
      "schema": "AlmoxarifadoItem",
      "description": "Collection of inventory items."
    }
  }
}
